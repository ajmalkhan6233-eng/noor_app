<?xml version="1.0" encoding="utf-8"?>
<!-- Real adaptive icon (API 26+): a solid obsidian background layer
     plus the gold-crescent/cyan-ring foreground, generated by
     scripts/gen_adaptive_icon.js — separate layers, not a flat PNG,
     so it correctly supports circle/squircle/rounded-square masking
     and motion (parallax/pinch) on launchers that animate adaptive
     icons. Pre-26 devices fall back to the existing flat PNGs in the
     density-specific mipmap-* folders. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
