<?xml version="1.0" encoding="utf-8"?>
<!-- Real adaptive icon (API 26+): a glossy gradient-sphere background
     bitmap plus the gold-crescent/cyan-ring/highlight foreground, both
     generated by scripts/gen_adaptive_icon.js — separate layers, not a
     flat PNG, so it correctly supports circle/squircle/rounded-square
     masking and motion (parallax/pinch) on launchers that animate
     adaptive icons. This is also what Android 12+'s system splash
     screen actually renders (windowSplashScreenAnimatedIcon resolves
     to this XML on API 31+, not the flat mipmap-*dpi PNGs) — keep the
     two layers in the same glossy-orb style as the in-app bottom-nav
     badges (noor_icon_style.dart) so the splash never regresses to the
     old flat icon again. Pre-26 devices fall back to the flat PNGs in
     the density-specific mipmap-* folders (gen_launcher_icon.js). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
